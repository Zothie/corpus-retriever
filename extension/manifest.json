{
  "manifest_version": 3,
  "name": "Corpus Retriever",
  "version": "1.0.2",
  "description": "Paste a DOI and save the paper to your Downloads folder.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_title": "Corpus Retriever",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "nativeMessaging",
    "alarms",
    "tabs",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "*://*.ssrn.com/*",
    "*://api.ssrn.com/*",
    "*://*.cell.com/*",
    "*://data.mendeley.com/*",
    "*://prod-dcd-datasets-public-files-eu-west-1.s3.eu-west-1.amazonaws.com/*",
    "*://*.sciencedirect.com/*",
    "*://pdf.sciencedirectassets.com/*",
    "*://*.nature.com/*",
    "*://*.link.springer.com/*",
    "*://*.onlinelibrary.wiley.com/*",
    "*://*.pubs.acs.org/*",
    "*://*.academic.oup.com/*",
    "*://*.silverchair.com/*",
    "*://aquila.usm.edu/*",
    "*://digitalcommons.calpoly.edu/*",
    "*://digitalcommons.chapman.edu/*",
    "*://digitalcommons.du.edu/*",
    "*://digitalcommons.georgiasouthern.edu/*",
    "*://digitalcommons.kennesaw.edu/*",
    "*://digitalcommons.law.uw.edu/*",
    "*://digitalcommons.lib.uconn.edu/*",
    "*://digitalcommons.odu.edu/*",
    "*://digitalcommons.pepperdine.edu/*",
    "*://digitalcommons.unf.edu/*",
    "*://digitalcommons.unl.edu/*",
    "*://digitalcommons.unomaha.edu/*",
    "*://digitalcommons.uri.edu/*",
    "*://digitalcommons.usf.edu/*",
    "*://digitalcommons.usu.edu/*",
    "*://digitalcommons.wayne.edu/*",
    "*://docs.lib.purdue.edu/*",
    "*://ecommons.udayton.edu/*",
    "*://egrove.olemiss.edu/*",
    "*://engagedscholarship.csuohio.edu/*",
    "*://epublications.marquette.edu/*",
    "*://ideaexchange.uakron.edu/*",
    "*://ir.lib.uwo.ca/*",
    "*://nsuworks.nova.edu/*",
    "*://oasis.library.unlv.edu/*",
    "*://openscholarship.wustl.edu/*",
    "*://opensiuc.lib.siu.edu/*",
    "*://repository.lsu.edu/*",
    "*://researchrepository.wvu.edu/*",
    "*://scholar.smu.edu/*",
    "*://scholarcommons.sc.edu/*",
    "*://scholarsarchive.byu.edu/*",
    "*://scholarship.richmond.edu/*",
    "*://scholarworks.uni.edu/*",
    "*://stars.library.ucf.edu/*",
