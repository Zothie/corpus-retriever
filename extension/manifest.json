    "*://api.core.ac.uk/*",
    "*://core.ac.uk/*",
    "*://europepmc.org/*",
    "*://pmc.ncbi.nlm.nih.gov/*",
    "*://eutils.ncbi.nlm.nih.gov/*",
    "*://ftp.ncbi.nlm.nih.gov/*",
    "*://www.ebi.ac.uk/*",
    "*://doi.org/*",
    "*://dx.doi.org/*",
